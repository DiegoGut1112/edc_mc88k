Verifica:	jmp(r1)


; Comprime (texto, comprdo)
Comprime:   

		PUSH (r1)
		PUSH (r31)						; Creo el marco de pila
		or r31, r30, r30				; 
		subu r30, r30, 28				; Reservo espacio para guardar texto, cmprdo, nBit, pos_pilaZona3ytexto, pilaZona3, longcadena
		or r29, r0, r0					; Como la mayoria de subrutinas devuelven el res en r29, me aseguro
										; que este iniciado a 0, aunq ya lo hago dentro de casi todas las subrutinas

		ld r20, r31, 8					; texto <- r20
		ld r21, r31, 12					; cmprdo <- r21

		; 1 Determinar long de texto llamando a LongCad

		st r20, r31, -4					; r31 - 4 <= texto
		st r21, r31, -8					; r31 - 8 <= cmprdo

		PUSH (r20)						; paso la cadena texto por la pila
		bsr LongCad						; llamo a longCad que me deuvlve la longitud en r29
		addu r30, r30, 4				; recupero puntero r30

		ld r20, r31, -4					; texto <- r20
		ld r21, r31, -8					; cmprdo <- r21

		or r3, r29, r29					; guardo la long de la cadena en r3

		; 2 Reservar espacio vl pilaZona3

		addu r4, r4, 3					; sumo 3 para que div y mulu ajusten por exceso en vez de "truncar"
		divu r4, r4, 4
		mulu r4, r4, 4					; en r4 <- num de bytes de texto ajustado por exceso a mult de 4
		subu r30, r30, r4				; se reservan r4 bytes vl

		; 3 Iniz variables

		or r4, r0, r0					; r4 <= pos_pilaZona3ytexto
		or r6, r0, r0					; r6 <= nBit del mapa de bits
		or r8, r30, r0					; r8 <- comienzo pilaZona3				COMPROBAR, NO SE SI APUNTA A LONGCAD O VACIO
		addu r21, r21, 5				; r21 <-salto la cabecera y apunta al princicipo del mapa de bits

		; 4 Copia de los 8xM (M=1) chars iniciales de texto al comienzo de pilaZona3

	cop_8x1:

		cmp r7, r4, 8
		bb1 eq, r7, buc_Comprime		; r4 se queda apuntando al sig char, al 9º (o num 8)
		ld.bu r10, r20, r4				; char en r10
		st.b r10, r8, r4				; guardo r10 en pilaZona3
		addu r4, r4, 1					; Avanzo pos en texto y pilaZona3, uso r4 como contador
		br cop_8x1
		

		; 5 Algoritmo compirmir

	buc_Comprime:

		ld.bu r9, r20, r4
		cmp r7, r9, 0					; comprobar si ha llegado al final de texto
		bb1 eq, r7, fin_comprime
		
			; si nBit multiplo de 8, iniciar a 0x00 el byte en el que esta contenido

		mask r16, r6, 7					; el 7 es 0111, y para que un num sea mult de 8 debe acabar en  X000, 
		cmp r7, r16, 0					; por tanto si es mult debe quedar 0000 en r16
		bb1 ne, r7, no_mult_de_8
		
		divu r15, r6, 8					; nBit/8 = byte al q pertenece el bit
		st.b r0, r21, r15				; pone el byte a 0

			; localizar sig subcadena repetida llamando a BuscaMax (texto, pos, Dir(P))

		st r6, r31, -12					; r31-12 <= nBit (r6)
		st r4, r31, -16					; r31-16 <= pos texto y pos pilaZona3 (r4)
		st r8, r31, -20					; r31-20 <= princicipo pilaZona3 (r8)
		st r3, r31, -24					; r31-24 <= long de texto (r3)

		no_mult_de_8:



		; 6 rellenar cabecera de comprdo

		; 7 Copiar pilaZona3 en cmprdo tras mapa de bytes

		; 8 valores de retorno

	fin_comprime:

		or r30, r31, r31		; destruir marco de pila
		POP (r31)
		POP (r1)
		jmp(r1)






















Descomprime:    jmp(r1)

LongCad:
		PUSH (r1)
		ld r22, r30, 4				; paso el valor de cadena a r22
		or r29, r0, r0				; pongo r29 a 0, que hes donde hay que guardar el resultado

	sig_char_LongCad:	
		ld.bu r5, r22, r0			; guardo en r5 el primer byte sin signo de la cadena
		cmp r7, r5, 0				; comparo el siguiente bit con \0
		bb1 eq, r7, end_longCad		; si el sig bit tampoco es \0 sigo, sino end_longCad
		addu r29, r29, 1			; aumento el resultado
		addu r22, r22, 1			; paso al sig byte de la cadena
		br sig_char_LongCad

	end_longCad:
		POP (r1)
		jmp(r1)

CoincidenCad:   
		PUSH(r1)
		ld r21, r30, 8			; cadena2
		ld r22, r30, 4			; cadena1
		or r29, r0, r0

	sig_char_CoincidenCad:
		ld.bu r5, r21, r0
		ld.bu r6, r22, r0
		cmp r7, r5, 0
		bb1 eq, r7, end_coincidenCad	;comparo que ambas cadenas no hayan terminado (llegar a \0)
		cmp r7, r6, 0
		bb1 eq, r7, end_coincidenCad
		cmp r7, r5, r6			; comparo si el el byte es el mismo
		bb0 eq, r7, end_coincidenCad
		addu r29, r29, 1		; si sin igaules r7 = 1 y entonces suma 1 al resultado
		addu r21, r21, 1
		addu r22, r22, 1
		br sig_char_CoincidenCad
		
	end_coincidenCad:		
		POP (r1)
		jmp(r1)

BuscaCar:       

		PUSH (r1)
		
		ld r25, r30, 4			; r25 -> C
		ld r22, r30, 8			; r22 -> ref
		ld r23, r30, 12			; r23 -> from
		ld r24, r30, 16			; to
		or r29, r23, r0			; r29 -> rv  empieza en from

	sig_char_BuscaCar:

		ld.bu r5, r22, r29			; r29=from para la primera iteracion

		cmp r7, r29, r24			; comparar que no haya llegado a to
		bb1 eq, r7, end_BuscaCar

		cmp r7, r5, r25				; comprueba si ha encontrado el char C
		bb1 eq, r7, end_BuscaCar

		addu r29, r29, 1			; avanza al siguiente byte
		br sig_char_BuscaCar

	end_BuscaCar:

		POP (r1)
		jmp(r1)

PoneBitA1:      PUSH (r1)

		ld r20, r30, 4				; dirZonaCB <-- r20
		ld r21, r30, 8				; NumBit <-- r21
		or r8, r21, r21				; r8 contador
		or r10, r0, r0				; pos del byte respecto a r20
		or r9, r0, 0x80				; r9 iniciado a 1000 0000 (pos del bit 0 a 1)

	buc_Byte_pb:

		cmp r7, r8, 7
		bb1 ls, r7, enc_Byte_pb		
		addu r10, r10, 1			; sig byte
		subu r8, r8, 8				; resta a NumBit 8 bits(1 byte)
		br buc_Byte_pb	
	
	enc_Byte_pb:

		ld.bu r4, r20, r10				; guardo en r4 el byte

	buc_masc_pb:

		cmp r7, r8, 0
		bb1 eq, r7, fin_poneBitA1			; si ha llegado al bit 
		divu r6, r9, 2					; divide entre dos
		addu r9, r6, r0					; (mueve el bit a 1 hacia la derecha, como un SHR)
		subu r8, r8, 1					; actualiza contador
		br buc_masc_pb
		

	fin_poneBitA1:	
		
		or r4, r4, r9					; cambia bit y
		st.b r4, r20, r10				; lo guarda en mem

		POP (r1)
		jmp(r1)

LeeBit:         PUSH (r1)

		ld r20, r30, 4				; dirZonaCB <-- r20
		ld r21, r30, 8				; NumBit <-- r21
		or r8, r21, r21				; r8 contador
		or r10, r0, r0				; pos del byte respecto a r20
		or r9, r0, 0x80				; r9 iniciado a 1000 0000 (pos del bit 0 a 1)
		or r29, r0, r0

	buc_Byte_lb:

		cmp r7, r8, 7
		bb1 ls, r7, enc_Byte_lb		
		addu r10, r10, 1			; sig byte
		subu r8, r8, 8				; resta a NumBit 8 bits(1 byte)
		br buc_Byte_lb	
	
	enc_Byte_lb:

		ld.bu r4, r20, r10				; guardo en r4 el byte

	buc_masc_lb:

		cmp r7, r8, 0
		bb1 eq, r7, bit_es_1o0				; si ya a llegado al bit, que identifique si es 1 o 0 
		divu r6, r9, 2					; divide entre dos 
		addu r9, r6, r0					; (mueve el bit a 1 hacia la derecha, como un SHR)
		subu r8, r8, 1					; actualiza contador
		br buc_masc_lb
		

	bit_es_1o0:	
						
		and r5, r4, r9					; hago un and para ver si el bit era 0 o 1
		cmp r7, r5, r0					; y compruebo si el valor cambia o no comparado con antes del and
		bb1 eq, r7, fin_LeeBit			; r5 = 0?: el bit era 0 (r29 se inicia a 0 asiq no hay que hacer nada)
		or r29, r0, 1					; r5 != 0?: el bit era 1
		br fin_LeeBit					; no haria falta, pero por si modifico algo

	fin_LeeBit:

		POP (r1)
		jmp (r1)


