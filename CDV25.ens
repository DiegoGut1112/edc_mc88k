; Macros que hemos visto en clase y pueden serme utiles a lo largo del proyecto

LEA:    MACRO (re, ETIQ)
        or re, r0,  low(ETIQ)
        or.u re, re, high(ETIQ)
        ENDMACRO

DBNZ:   MACRO (re, ETIQ)
        sub	re, re, 1
        cmp	r2, re, r0
        bb0	eq, r2, ETIQ
        ENDMACRO
		  
LOAD: 	MACRO (re, ETIQ)
        LEA (re, ETIQ)
        ld	re, re, r0
        ENDMACRO

PUSH:   MACRO (re)
        subu r30, r30, 4
        st re, r30, r0
        ENDMACRO

POP:    MACRO (re)
        ld re, r30, r0
        addu r30, r30, 4
        ENDMACRO


org 4000

